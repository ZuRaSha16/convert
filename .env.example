# Copy to .env.local. Keep these server-only. Never use NEXT_PUBLIC_ prefixes.
# Create the table using supabase/waitlist.sql before enabling registration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Set to the real public origin when deploying, for absolute social image URLs.
SITE_URL=http://localhost:3000
# Optional welcome emails. Verify your sender domain in Resend first.
# When enabled, SITE_URL must be your public HTTPS URL (used for logo and links).
RESEND_API_KEY=
# Example format: Convert <hello@your-owned-domain.com>
WAITLIST_EMAIL_FROM=
# Optional monitored inbox for replies; defaults to the From address.
WAITLIST_EMAIL_REPLY_TO=
